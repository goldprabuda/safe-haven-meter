+// ── SAFE-HAVEN METER ──────────────────────────────────────────────
+// Regime context: is war fear lifting gold, or is the Fed's rate headwind winning?
+async function fetchSafeHaven() {
+  const m = await safeFetch(SAFE_HAVEN_URL, 'Safe-haven meter');
+  if (!m?.generatedUnix) return null;
+  m.ageHours = (Date.now() / 1000 - m.generatedUnix) / 3600;
+  if (m.ageHours > 8) { warn(`Safe-haven meter is ${m.ageHours.toFixed(1)}h old — ignoring`); return null; }
+  return m;
+}
+
+function buildMeterSection(m) {
+  if (!m) return 'Unavailable — judge regime from the data above.';
+  return [
+    `Meter: ${m.meter}/100 (${m.zone})  |  Trade read: ${String(m.bias).toUpperCase()}  |  Fed regime: ${m.regime}`,
+    `Gauges: fear ${m.fear}, rate & dollar headwind ${m.headwind}, inflation ${m.inflation}, flows ${m.flows}  (50 = normal)`,
+    `Gold trend: ${m.goldTrend}  |  Flags: ${m.flags || 'none'}`,
+    `Note: ${m.note}`,
+  ].join('\n');
+}
+
+// One plain line for alerts (no underscores or asterisks: Telegram Markdown would break)
+function meterLine(m) {
+  if (!m) return null;
+  const clean = v => String(v ?? '').replace(/[_*`\[\]]/g, ' ');
+  return `Safe-haven meter ${Math.round(m.meter)}/100 ${clean(m.zone)} | Fed ${clean(m.regime)} | bias ${clean(m.bias)}`;
+}
